---
// Replaces Starlight's language select with a menu of flags. Each item links to the same page in
// that language. The languages are in src/i18n/locales.mjs.
import br from 'flag-icons/flags/4x3/br.svg';
import cn from 'flag-icons/flags/4x3/cn.svg';
import de from 'flag-icons/flags/4x3/de.svg';
import es from 'flag-icons/flags/4x3/es.svg';
import fr from 'flag-icons/flags/4x3/fr.svg';
import gb from 'flag-icons/flags/4x3/gb.svg';
import id from 'flag-icons/flags/4x3/id.svg';
import jp from 'flag-icons/flags/4x3/jp.svg';
import kr from 'flag-icons/flags/4x3/kr.svg';
import th from 'flag-icons/flags/4x3/th.svg';
import tr from 'flag-icons/flags/4x3/tr.svg';
import tw from 'flag-icons/flags/4x3/tw.svg';
import { languageKey } from '@/i18n/language-redirect.mjs';
import { locales } from '@/i18n/locales.mjs';
import { localePath, stripLocale } from '@/i18n/utils';
import '@/styles/header-menu.css';

const flags: Record<string, ImageMetadata> = { br, cn, de, es, fr, gb, id, jp, kr, th, tr, tw };

const currentCode = Astro.locals.starlightRoute.locale ?? 'root';
const current = locales.find((locale) => locale.code === currentCode) ?? locales[0];
const path = stripLocale(Astro.url.pathname);
---

<details class="header-menu lang-menu" data-key={languageKey}>
	<summary aria-label={Astro.locals.t('languageSelect.accessibleLabel')}>
		<img src={flags[current.flag].src} alt="" width="20" height="15" />
		<span class="current">{current.label}</span>
	</summary>
	<ul class="header-menu-list">
		{
			locales.map((locale) => (
				<li>
					<a
						class="header-menu-item"
						href={localePath(locale.code, path)}
						hreflang={locale.lang}
						data-language={locale.code === 'root' ? '' : locale.code}
						lang={locale.lang}
						aria-current={locale.code === currentCode ? 'true' : undefined}
					>
						<img src={flags[locale.flag].src} alt="" width="20" height="15" loading="lazy" />
						{locale.label}
					</a>
				</li>
			))
		}
	</ul>
</details>

<script>
	import '@/scripts/header-menus';

	const menus = document.querySelectorAll<HTMLDetailsElement>('.lang-menu');

	// Remember the language the reader chose, so that it is not replaced by the browser's
	// language on the next visit. See src/i18n/language-redirect.mjs.
	for (const menu of menus) {
		for (const link of menu.querySelectorAll<HTMLAnchorElement>('a[data-language]')) {
			link.addEventListener('click', () => {
				try {
					localStorage.setItem(menu.dataset.key!, link.dataset.language!);
				} catch {
					// Without storage, the browser's language is used again next time.
				}
			});
		}
	}
</script>

<style>
	img {
		flex-shrink: 0;
		border-radius: 2px;
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.15);
	}

	/* The header is narrow on medium screens: show only the flag there. */
	@media (min-width: 50rem) and (max-width: 72rem) {
		:global(.right-group) .current {
			display: none;
		}
	}
</style>
