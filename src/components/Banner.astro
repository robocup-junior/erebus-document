---
// Shows a notice on the sites of old versions. See src/data/versions.ts.
import { archivedVersion, latestSite } from '@/data/versions';
import { localePath } from '@/i18n/utils';

const { t, starlightRoute } = Astro.locals;
---

{
	archivedVersion && (
		<div class="archived-notice">
			{t('archived.notice', { version: archivedVersion })}
			<a href={`${latestSite}${localePath(starlightRoute.locale, '/docs/')}`}>{t('archived.link')}</a>
		</div>
	)
}

<style>
	.archived-notice {
		padding: 0.5rem 1rem;
		background: var(--sl-color-orange-low);
		color: var(--sl-color-orange-high);
		font-size: 0.875rem;
		text-align: center;
	}

	a {
		margin-inline-start: 0.25rem;
		color: inherit;
		font-weight: 700;
	}
</style>
