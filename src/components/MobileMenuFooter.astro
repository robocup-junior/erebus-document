---
// The bottom of the mobile menu: only the social links, since the theme and language menus are in
// the header on phones (see Header.astro).
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
---

<div class="mobile-preferences sl-flex">
	<div class="social-icons"><SocialIcons /></div>
</div>

<style>
	.mobile-preferences {
		border-top: 1px solid var(--sl-color-gray-6);
		padding: 0.5rem 0;
	}

	.social-icons {
		display: flex;
		gap: 1rem;
		align-items: center;
		padding-block: 1rem;
	}
</style>
