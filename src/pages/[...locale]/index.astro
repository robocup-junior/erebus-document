---
// The home page, built for each language: / and /ja/, for example. Update the values below for
// each Erebus release. The text is in the "home.*" strings of src/content/i18n/.
// Media is in public/home/: real footage and screenshots from Webots.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import PartOfRoboCupJunior from '@/components/PartOfRoboCupJunior.astro';
import customizerScreenshot from '@/content/docs/docs/robot/customizer/customizer.png';
import worldEditorScreenshot from '@/content/docs/docs/tools/world-editor/overview.png';
import { copyright } from '@/data/copyright';
import { localeCodes } from '@/i18n/locales.mjs';

export const getStaticPaths = (() => [
	{ params: { locale: undefined } },
	...localeCodes.map((locale) => ({ params: { locale } })),
]) satisfies GetStaticPaths;

const { t } = Astro.locals;

const version = '26.1';
const rulesYear = '2026';
const downloadUrl = `https://github.com/robocup-junior/erebus/archive/refs/tags/v${version}.zip`;

// Hero clips, played in random order. Each is public/home/hero-<name>.mp4.
const heroClips = ['follow', 'overview', 'topdown', 'slide'];

const stats = [
	{ value: '4', label: t('home.stats.areas') },
	{ value: '8', label: t('home.stats.minutes') },
	{ value: '3000', label: t('home.stats.budget') },
	{ value: '×2.2', label: t('home.stats.map') },
];

const missions = [
	{ key: 'explore', image: '/home/explore.jpg', link: '/docs/programming/navigate-the-maze/' },
	{ key: 'identify', image: '/home/identify.jpg', link: '/docs/programming/wall-tokens/' },
] as const;

const tools = [
	{ key: 'robot', link: 'https://robot.erebus.rcj.cloud/', screenshot: customizerScreenshot },
	{ key: 'world', link: 'https://world.erebus.rcj.cloud/', screenshot: worldEditorScreenshot },
] as const;

// The top of the real answer for world2.wbt.
const mapRows = [
	'1111111111111111111111P11111111',
	'1404000000001000020210000000030',
	'1000000010001000000010000000000',
	'14040000C0000000020210000000030',
	'1111100010000000111110001111100',
	'10100000000000001b0b00000000100',
	'1U10000000000011100000000000O00',
	'10000000000000001b0b00000000100',
	'1000000010000000100011111111100',
	'100000001p0p0000000004041000000',
];

const cellClass = (cell: string) => {
	if (cell === '0') return 'empty';
	if (cell === '1') return 'wall';
	return /[A-Z]/.test(cell) ? 'token' : 'floor';
};

// Structured data, so that search engines know what Erebus is.
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{ '@type': 'WebSite', name: 'Erebus', url: 'https://erebus.rcj.cloud/' },
		{
			'@type': 'SoftwareApplication',
			name: 'Erebus',
			applicationCategory: 'EducationalApplication',
			operatingSystem: 'Windows, macOS, Linux',
			softwareVersion: version,
			description:
				'Rescue simulation platform of RoboCupJunior, built on Webots. Program a robot to explore a maze, identify wall tokens and map the environment.',
			url: 'https://erebus.rcj.cloud/',
			downloadUrl,
			offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
			isPartOf: { '@type': 'Organization', name: 'RoboCupJunior', url: 'https://junior.robocup.org/' },
		},
	],
};

const steps = [
	{ key: 'install', link: '/docs/installation/' },
	{ key: 'rules', link: '/docs/rules/' },
	{ key: 'robot', link: '/docs/robot/' },
	{ key: 'program', link: '/docs/programming/' },
] as const;
---

<StarlightPage
	hasSidebar={false}
	frontmatter={{
		title: t('home.title'),
		description: t('home.description'),
		template: 'splash',
		editUrl: false,
		lastUpdated: false,
	}}
>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<div class="home not-content">
		<section class="hero">
			<div id="hero-clips" data-clips={JSON.stringify(heroClips)} aria-hidden="true">
				<video class="active" muted playsinline poster="/home/hero-poster.jpg"></video>
				<video muted playsinline></video>
			</div>
			<div class="hero-inner">
				<div class="hero-copy">
					<p class="kicker">RoboCupJunior Rescue Simulation</p>
					<h1>{t('home.hero.title')} <span>{t('home.hero.titleAccent')}</span></h1>
					<p class="lead">{t('home.hero.lead')}</p>
					<div class="actions">
						<a class="button primary" href="/docs/">{t('home.hero.start')} →</a>
						<a class="button ghost" href={downloadUrl}>{t('home.hero.download', { version })}</a>
					</div>
				</div>

			</div>
		</section>

		<ul class="stats">
			{stats.map((stat) => <li><b>{stat.value}</b><span>{stat.label}</span></li>)}
		</ul>

		<section class="section">
			<p class="kicker">{t('home.mission.kicker')}</p>
			<h2>{t('home.mission.title')}</h2>

			{
				missions.map((mission, index) => (
					<article class="mission">
						<img src={mission.image} alt={t(`home.${mission.key}.alt`)} loading="lazy" />
						<div>
							<span class="number">0{index + 1}</span>
							<h3>{t(`home.${mission.key}.title`)}</h3>
							<p>{t(`home.${mission.key}.text`)}</p>
							<a href={mission.link}>{t(`home.${mission.key}.link`)} →</a>
						</div>
					</article>
				))
			}

			<article class="mission">
				<div class="map-demo">
					<img src="/home/map.jpg" alt={t('home.map.alt')} loading="lazy" />
					<div class="matrix" aria-hidden="true">
						{
							mapRows.map((row) => (
								<div>{[...row].map((cell) => <span class={cellClass(cell)}>{cell}</span>)}</div>
							))
						}
					</div>
				</div>
				<div>
					<span class="number">03</span>
					<h3>{t('home.map.title')}</h3>
					<p>{t('home.map.text')}</p>
					<a href="/docs/rules/mapping/">{t('home.map.link')} →</a>
				</div>
			</article>
		</section>

		<section class="tools">
			<div class="section">
				<p class="kicker">{t('home.tools.kicker')}</p>
				<h2>{t('home.tools.title')}</h2>
				<div class="tool-grid">
					{
						tools.map((tool) => (
							<a class="tool" href={tool.link}>
								<Image
									class="screenshot"
									src={tool.screenshot}
									alt=""
									widths={[600, 900, 1300]}
									sizes="(max-width: 60rem) 100vw, 36rem"
									loading="lazy"
								/>
								<div class="tool-text">
									<h3>{t(`home.tools.${tool.key}.title`)}</h3>
									<p>{t(`home.tools.${tool.key}.text`)}</p>
								</div>
							</a>
						))
					}
					<a class="tool community" href="https://discord.com/invite/6FJxZxk">
						<h3>{t('home.tools.community.title')}</h3>
						<p>{t('home.tools.community.text')}</p>
					</a>
				</div>
			</div>
		</section>

		<section class="start">
			<div class="section">
				<h2>{t('home.start.title')}</h2>
				<ol>
					{
						steps.map((step) => (
							<li>
								<a href={step.link}>
									<b>{t(`home.start.${step.key}.title`)}</b>
									<span>{t(`home.start.${step.key}.text`)}</span>
								</a>
							</li>
						))
					}
				</ol>
				<div class="part-of"><PartOfRoboCupJunior /></div>
				<p class="release">
					Erebus v{version} · {t('home.release.rules', { year: rulesYear })} · Webots R2023b ·{' '}
					<a href="https://github.com/robocup-junior/erebus">GitHub</a> ·{' '}
					<a href="/docs/reference/versions/">{t('home.release.otherVersions')}</a> ·{' '}
					<a href="/docs/privacy/">{t('home.release.privacy')}</a>
				</p>
				<p class="copyright">{copyright}</p>
			</div>
		</section>
	</div>
</StarlightPage>

<script>
	const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// Plays the clips in random order, crossfading between the two video layers.
	const crossfadeSeconds = 1.2;
	const clipBox = document.querySelector<HTMLElement>('#hero-clips');
	const clips: string[] = JSON.parse(clipBox?.dataset.clips ?? '[]');
	const layers = [...document.querySelectorAll<HTMLVideoElement>('#hero-clips video')];
	let activeLayer = 0;
	let currentClip = '';
	let switching = false;

	async function playNextClip(layer: number) {
		const options = clips.filter((clip) => clip !== currentClip);
		currentClip = options[Math.floor(Math.random() * options.length)];
		layers[layer].src = `/home/hero-${currentClip}.mp4`;
		try {
			await layers[layer].play();
		} catch {
			return; // The poster stays if the browser blocks playback.
		}
		layers[activeLayer].classList.toggle('active', layer === activeLayer);
		layers[layer].classList.add('active');
		activeLayer = layer;
		switching = false;
	}

	layers.forEach((video, index) => {
		video.addEventListener('timeupdate', () => {
			const nearEnd = video.duration - video.currentTime < crossfadeSeconds;
			if (index === activeLayer && nearEnd && !switching) {
				switching = true;
				void playNextClip(1 - index);
			}
		});
	});

	if (!reducedMotion) void playNextClip(0);
</script>

<style is:global>
	/* Let the home page use the full width below the Starlight header. */
	body:has(.home) {
		overflow-x: clip;
	}

	body:has(.home) .content-panel {
		padding: 0;
		border: 0;
	}

	body:has(.home) .sl-container {
		max-width: none;
		margin: 0;
	}

	body:has(.home) .content-panel:has(h1#_top) {
		display: none;
	}

	/* The hero starts right under the header, and the last section ends the page */
	body:has(.home) main {
		padding-bottom: 0;
	}

	body:has(.home) .sl-markdown-content > .home {
		margin-top: 0;
	}

	body:has(.home) footer,
	body:has(.home) .footer-part-of {
		display: none;
	}
</style>

<style>
	.home {
		--tile-blue: #2f4bff;
		--tile-purple: #7a35d0;
		--tile-red: #f03535;
		--tile-swamp: #b08f50;
	}

	.kicker {
		margin: 0 0 0.75rem;
		color: var(--sl-color-text-accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1,
	h2,
	h3 {
		margin: 0;
		color: var(--sl-color-white);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	/* Hero */
	.hero {
		position: relative;
		display: flex;
		align-items: flex-end;
		min-height: calc(100svh - var(--sl-nav-height));
		overflow: hidden;
		background: #0b1216;
		color: #fff;
	}

	/* Wider than the page and aligned left, which puts the robot beside the text. */
	.hero video {
		position: absolute;
		top: 0;
		left: 0;
		width: 130%;
		max-width: none;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 1.2s ease;
	}

	.hero video.active {
		opacity: 1;
	}

	.hero::after {
		content: '';
		position: absolute;
		z-index: 0;
		inset: 0;
		background:
			linear-gradient(to top, rgb(5 12 16 / 0.92), transparent 62%),
			linear-gradient(to right, rgb(5 12 16 / 0.72), transparent 58%);
	}

	.hero-inner {
		z-index: 1;
		width: min(100%, 76rem);
		margin: 0 auto;
		padding: 3rem 1.5rem 3.5rem;
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		max-width: 38rem;
	}

	.hero .kicker {
		color: #7fdcef;
	}

	h1 {
		color: #fff;
		font-size: clamp(3rem, 7vw, 5.5rem);
		line-height: 0.98;
		text-shadow: 0 0.1em 1em rgb(0 0 0 / 0.5);
		/* Breaks Japanese and other languages without spaces between phrases, not inside words. */
		word-break: auto-phrase;
	}

	h1 span {
		display: block;
		background: linear-gradient(90deg, #7fdcef, #8ea2ff 55%, #c79bff);
		background-clip: text;
		color: transparent;
	}

	.lead {
		max-width: 34rem;
		margin: 1.5rem 0 2rem;
		color: #dbe6ea;
		font-size: clamp(1.05rem, 1.6vw, 1.3rem);
		line-height: 1.5;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.button {
		padding: 0.8rem 1.6rem;
		border-radius: 0.6rem;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.15s ease;
	}

	.button:hover {
		transform: translateY(-2px);
	}

	.primary {
		background: #7fdcef;
		color: #06222b;
	}

	.ghost {
		border: 1px solid rgb(255 255 255 / 0.45);
		color: #fff;
		backdrop-filter: blur(6px);
	}

	/* Numbers */
	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin: 0;
		padding: 0;
		background: linear-gradient(90deg, var(--tile-blue), var(--tile-purple) 60%, var(--tile-red));
		color: #fff;
		list-style: none;
	}

	.stats li {
		padding: 1.5rem 1rem;
		text-align: center;
	}

	.stats b {
		display: block;
		font-size: clamp(1.8rem, 4vw, 2.75rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
	}

	.stats span {
		font-size: 0.85rem;
		opacity: 0.9;
	}

	/* Sections */
	.section {
		width: min(100%, 76rem);
		margin: 0 auto;
		padding: 5.5rem 1.5rem;
	}

	h2 {
		font-size: clamp(2.2rem, 5vw, 3.75rem);
	}

	.mission {
		display: grid;
		grid-template-columns: 1.35fr 1fr;
		gap: 3.5rem;
		align-items: center;
		margin-top: 4.5rem;
	}

	.mission:nth-of-type(even) > :first-child {
		order: 1;
	}

	.mission img {
		display: block;
		width: 100%;
		border-radius: 1rem;
		box-shadow: 0 1.5rem 3.5rem -1.5rem rgb(0 0 0 / 0.6);
	}

	.number {
		color: var(--sl-color-text-accent);
		font-family: var(--sl-font-mono);
		font-weight: 700;
	}

	h3 {
		font-size: clamp(1.8rem, 3.5vw, 2.6rem);
	}

	.mission h3 {
		margin: 0.25rem 0 0.75rem;
	}

	.mission p {
		margin: 0 0 1rem;
		font-size: 1.1rem;
		line-height: 1.6;
	}

	.mission a {
		color: var(--sl-color-text-accent);
		font-weight: 700;
		text-decoration: none;
	}

	/* The map, as the robot reports it */
	.map-demo {
		position: relative;
	}

	.matrix {
		position: absolute;
		right: -1rem;
		bottom: -1.5rem;
		padding: 0.75rem 0.9rem;
		border: 1px solid rgb(255 255 255 / 0.16);
		border-radius: 0.6rem;
		background: rgb(8 20 26 / 0.92);
		font-family: var(--sl-font-mono);
		font-size: clamp(0.5rem, 0.95vw, 0.72rem);
		line-height: 1.25;
		white-space: pre;
	}

	.matrix .empty {
		color: #40545c;
	}

	.matrix .wall {
		color: #5cc4d8;
	}

	.matrix .floor {
		color: #e9b95f;
		font-weight: 700;
	}

	.matrix .token {
		color: #ff7676;
		font-weight: 700;
	}

	/* Tools */
	.tools {
		background: var(--sl-color-gray-6);
	}

	.tool-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		margin-top: 2.5rem;
	}

	.tool {
		display: flex;
		flex-direction: column;
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline);
		border-radius: 1rem;
		background: var(--sl-color-bg);
		color: inherit;
		text-decoration: none;
		transition:
			transform 0.15s ease,
			border-color 0.15s ease;
	}

	.tool:hover {
		border-color: var(--sl-color-accent);
		transform: translateY(-3px);
	}

	/* A screenshot of the tool, cut to the same height for both cards */
	.screenshot {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		object-position: top left;
		border-bottom: 1px solid var(--sl-color-hairline);
	}

	.tool-text,
	.community {
		padding: 1.5rem 1.75rem 1.75rem;
	}

	/* No screenshot for the community: a full-width row under the tools */
	.community {
		grid-column: 1 / -1;
	}

	.tool h3 {
		font-size: 1.35rem;
		letter-spacing: -0.02em;
	}

	.tool p {
		margin: 0.6rem 0 0;
		color: var(--sl-color-gray-2);
	}

	/* Call to action */
	.start {
		background:
			linear-gradient(rgb(5 12 16 / 0.82), rgb(5 12 16 / 0.92)),
			url('/home/map.jpg') center / cover;
		color: #fff;
		text-align: center;
	}

	.start h2 {
		color: #fff;
	}

	.start ol {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 1rem;
		margin: 2.5rem 0 2rem;
		padding: 0;
		counter-reset: step;
		list-style: none;
	}

	.start li {
		counter-increment: step;
	}

	.start ol a {
		display: block;
		height: 100%;
		padding: 1.5rem;
		border: 1px solid rgb(255 255 255 / 0.2);
		border-radius: 1rem;
		background: rgb(255 255 255 / 0.06);
		color: #fff;
		text-decoration: none;
		transition: background 0.15s ease;
	}

	.start ol a:hover {
		background: rgb(127 220 239 / 0.2);
	}

	.start b {
		display: block;
		font-size: 1.3rem;
	}

	.start b::before {
		content: counter(step) '. ';
		color: #7fdcef;
	}

	.part-of {
		margin: 0 0 1.75rem;
		color: #dbe6ea;
	}

	.release {
		margin: 0;
		color: #b8c9cf;
		font-size: 0.9rem;
	}

	.release a {
		color: #7fdcef;
	}

	.copyright {
		margin: 0.6rem 0 0;
		color: #8fa3aa;
		font-size: 0.8rem;
	}

	@media (max-width: 60rem) {
		/* On narrow screens the video sits above the text. */
		.hero video {
			width: 100%;
			height: 60%;
		}

		.hero::after {
			background: linear-gradient(to top, #0b1216 42%, transparent 62%);
		}

		.mission,
		.mission:nth-of-type(even) {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.mission:nth-of-type(even) > :first-child {
			order: 0;
		}

		.matrix {
			right: 0.5rem;
		}

		.stats,
		.tool-grid,
		.start ol {
			grid-template-columns: 1fr 1fr;
		}

		.tool-grid,
		.start ol {
			grid-template-columns: 1fr;
		}
	}
</style>
